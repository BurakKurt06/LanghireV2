# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
*.egg-info
wheels/

# Virtual environments
.venv
.python-version

# ── Node.js ───────────────────────────────────────────────────────────────
node_modules/
dist/
*.local

# ── Tauri ─────────────────────────────────────────────────────────────────
src-tauri/target/
src-tauri/gen/

# ── User Data (sensitive / personal) ──────────────────────────────────────
# Anchored with a leading slash so they match only these runtime files at the
# repo root. Unanchored, `jobs.json` also matched src/locales/*/jobs.json and
# silently kept all 13 translation files out of the repo, which broke a fresh
# clone: src/i18n/index.ts statically imports ../locales/en/jobs.json.
/candidate_profile.json
/qa_repository.json
/jobs.json
/applied_jobs.json
/memory_store.db
/memory_store.db-wal
/memory_store.db-shm
/memory_export.json

# Browser profiles (large, user-specific cookies/sessions)
browser_profile/
browser_profile_w*/

# Logs (large, per-run conversation logs)
logs/

# Resumes (user-specific)
resumes/

# Fonts (redistributable but large)
fonts/

# Lock files
jobs.json.lock
uv.lock

# ── OS Files ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────
.idea/
.vscode/
.kiro/
*.swp
*.swo

# ── Environment / Secrets ─────────────────────────────────────────────────
.env
.env.local
.env.production

# ── PyInstaller ───────────────────────────────────────────────────────────
build/
src-tauri/binaries/

# ── Test / Coverage artifacts ─────────────────────────────────────────────
coverage/
htmlcov/
.coverage
coverage.xml
.pytest_cache/
node_modules/.tmp/

# ── Build artifacts ───────────────────────────────────────────────────────
*.dmg
*.exe
*.AppImage
*.msi
*.deb
*.rpm
