---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import ScreenshotShowcase from '../components/ScreenshotShowcase.astro';
import DownloadSection from '../components/DownloadSection.astro';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'LangHire',
  description: 'AI-powered job application automation with a native desktop UI. Uses browser agents to collect jobs from ten job boards and fill out applications, with a memory of what worked.',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Windows',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  downloadUrl: 'https://github.com/BurakKurt06/LanghireV2/releases',
  softwareVersion: '1.0.0',
  license: 'https://opensource.org/licenses/MIT',
};
---

<BaseLayout
  title="LangHire - AI-Powered Job Application Automation"
  description="Automate your job applications with AI. LangHireV2 uses browser agents to collect jobs from ten job boards, fill out applications and upload your resume, with a memory of what worked. Free, open source, for Windows; your data stays on your machine."
>
  <StructuredData data={softwareSchema} />
  <Hero />
  <HowItWorks />
  <FeaturesGrid />
  <ScreenshotShowcase />
  <DownloadSection />
</BaseLayout>
